<?xml version="1.0" encoding="utf-8"?>
<!-- 单 libmsplayer.so 调试 Demo；包名由 scripts/android_single_apk.sh 按路线替换 @PKG@ / @LABEL@。
     by: Long <mycjzb@gmail.com> -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@PKG@"
    android:versionCode="1"
    android:versionName="s3">
    <uses-sdk android:minSdkVersion="18" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <application
        android:label="@LABEL@"
        android:debuggable="true"
        android:usesCleartextTraffic="true">
        <activity android:name="com.msmedia.demo.MsSpeedDemoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:label="@LABEL@">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
