+/* MsMedia: apply X-TIMESTAMP-MAP
+ * HLS 外挂 WebVTT 用 LOCAL+MPEGTS 把 cue 本地时间映射到 MPEG-TS 90 kHz
+ * 媒体时间。字段顺序不固定。解析失败则保持未映射。 */
+static int parse_webvtt_timestamp_map(const char *p, int64_t *local_ms, int64_t *mpegts)
+{
+    const char *m = strstr(p, "X-TIMESTAMP-MAP=");
+    const char *local_s = NULL, *mpeg_s = NULL, *q;
+    int64_t loc;
+    unsigned long long raw;
+    char *end;
+
+    if (!m)
+        return 0;
+    q = m + 16;
+    while (*q && *q != '\r' && *q != '\n') {
+        if (!strncmp(q, "LOCAL:", 6))
+            local_s = q + 6;
+        else if (!strncmp(q, "MPEGTS:", 7))
+            mpeg_s = q + 7;
+        q++;
+    }
+    if (!local_s || !mpeg_s)
+        return 0;
+    loc = read_ts(local_s);
+    if (loc == AV_NOPTS_VALUE)
+        return 0;
+    raw = strtoull(mpeg_s, &end, 10);
+    if (end == mpeg_s)
+        return 0;
+    *local_ms = loc;
+    *mpegts = (int64_t)raw;
+    return 1;
+}
